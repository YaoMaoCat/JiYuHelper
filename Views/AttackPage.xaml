<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="JiYuHelper.Views.AttackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JiYuHelper.Views"
    xmlns:core="using:JiYuHelper.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Padding="24" RowSpacing="16" MinWidth="760">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="攻击配置" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="目标: 通过 TCP 4806 (WORB 握手 + 协议包) 攻击教师端"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
        </StackPanel>

        <!-- 攻击模式选择 -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="攻击模式" Style="{StaticResource SubtitleTextBlockStyle}"/>

                <RadioButton x:Name="ModeFileSubmit" GroupName="AttackMode" Tag="0" IsChecked="True" Content="FILESUBMIT 协议崩溃"/>
                <RadioButton x:Name="ModeAnswerSheet" GroupName="AttackMode" Tag="1" Content="ANSWERSHEET 协议崩溃"/>
                <RadioButton x:Name="ModeUpfb" GroupName="AttackMode" Tag="2" Content="UPFB 上传崩溃"/>
                <!-- 以下模式暂时隐藏 待验证后恢复
                <RadioButton x:Name="ModeWorbFlood" GroupName="AttackMode" Tag="3" Content="WORB 握手轰炸"/>
                <RadioButton x:Name="ModeQrms" GroupName="AttackMode" Tag="4" Content="QRMS 堆溢出"/>
                <RadioButton x:Name="ModeRfsa" GroupName="AttackMode" Tag="5" Content="RFSA 答题堆溢出"/>
                <RadioButton x:Name="ModeQdat" GroupName="AttackMode" Tag="6" Content="QDAT 块溢出"/>
                <RadioButton x:Name="ModeBlkc" GroupName="AttackMode" Tag="7" Content="BLKC 块溢出"/>
                <RadioButton x:Name="ModePgij" GroupName="AttackMode" Tag="8" Content="PGIJ 成员名溢出"/>
                -->
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8" Width="300">
                <TextBlock Text="目标" Style="{StaticResource SubtitleTextBlockStyle}"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6" Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TargetIpText" Text="未选择目标"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   FontFamily="Consolas"/>
                        <TextBlock x:Name="TargetSourceText" Text="请在「扫描」页扫描并选中教师机"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Button x:Name="PickFromListButton" Click="OnPickFromListClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14"/>
                        <TextBlock Text="前往扫描页选择"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="参数" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0"/>
                <NumberBox x:Name="ThreadCountBox" Header="线程数" Value="10" Minimum="1" Maximum="200" SpinButtonPlacementMode="Inline"/>
                <NumberBox x:Name="DurationBox" Header="持续时间 (秒)" Value="60" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Inline"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="8">
                <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="OnStartClick"
                        HorizontalAlignment="Stretch" MinWidth="120">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14"/>
                        <TextBlock Text="开始攻击"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Click="OnStopClick" IsEnabled="False"
                        HorizontalAlignment="Stretch" MinWidth="120">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                        <TextBlock Text="停止攻击"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Grid>
        </ScrollViewer>

        <!-- 底部攻击状态栏 (固定显示, 不随配置区滚动 -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16,10" Margin="24,0,24,16">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" MinWidth="90">
                        <TextBlock x:Name="StatPackets" Text="0" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="已发包数" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" MinWidth="90">
                        <TextBlock x:Name="StatBytes" Text="0 B" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="已发字节" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" MinWidth="90">
                        <TextBlock x:Name="StatCrashes" Text="0" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="崩溃信号" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2" MinWidth="90">
                        <TextBlock x:Name="StatThreads" Text="0" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="活动线程" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" x:Name="AttackProgress" IsIndeterminate="False"
                             Minimum="0" Maximum="100" Value="0" Height="6"/>

                <TextBlock Grid.Row="2" x:Name="AttackStateText" Text="空闲"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
