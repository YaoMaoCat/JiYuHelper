<?xml version="1.0" encoding="utf-8"?>
<!--
  HookPage.xaml - 「控制」页
  功能分组与 JiYuHook 源码一一对应:
    块1 远程控制拦截 (脱控)     -> hook/remote, tdmaster, procguard, filterguard, master_hook/guard
    块2 界面与进程 (窗口化)     -> hook/topmost, focuslock, applist, proclist
    块3 屏幕监控               -> hook/screen (假屏), screencap (BitBlt), monitor (黑屏通知)
    块4 输入                   -> hook/keyboard
  开关 x:Name = "Switch" + HookSettings 字段名 (code-behind 反射绑定)。-->
<Page
    x:Class="JiYuHelper.Views.HookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JiYuHelper.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="16" MinWidth="760">

                <!-- 1. 标题区 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="控制" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="注入极域主进程 (StudentMain.exe) 与 MasterHelper.exe，按需启用 Hook 功能"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
                </StackPanel>

                <!-- 2. 进程状态卡片 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="进程状态" Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <!-- StudentMain.exe 状态行 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="StudentMain.exe" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="StudentMainStatusText" Text="检测中..."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Ellipse Grid.Column="2" x:Name="StudentMainDot" Width="10" Height="10"
                                     Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                     VerticalAlignment="Center"/>
                        </Grid>

                        <!-- MasterHelper.exe 状态行 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="MasterHelper.exe (SYSTEM)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="MasterHelperStatusText" Text="检测中..."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Ellipse Grid.Column="2" x:Name="MasterHelperDot" Width="10" Height="10"
                                     Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. 注入控制卡片 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="注入控制" Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="InjectButton" Style="{StaticResource AccentButtonStyle}" Click="OnInjectClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                                    <TextBlock Text="注入并启用"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="UninjectButton" Click="OnUninjectClick" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                                    <TextBlock Text="卸载"/>
                                </StackPanel>
                            </Button>
                            <ToggleSwitch x:Name="AutoReinjectSwitch" Header="自动重注入"
                                          Toggled="OnAutoReinjectToggled"
                                          OffContent="关" OnContent="开"/>
                        </StackPanel>

                        <!-- 提权提示 -->
                        <TextBlock x:Name="ElevationHintText"
                                   Text="注入 MasterHelper.exe 需要管理员权限"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ============ 块1: 远程控制拦截 (脱控) ============ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;" FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="远程控制拦截 (脱控)" Style="{StaticResource SubtitleTextBlockStyle}" Tag="name-group-remote"/>
                        </StackPanel>

                        <!-- 远程输入拦截: hook/remote.cpp SendInput + BlockInput -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="远程输入拦截" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-remote-input"/>
                                <TextBlock Text="拦截 SendInput / BlockInput，教师端模拟键鼠与锁定输入失效"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端无法远程操作你的鼠标键盘" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchRemoteInput" Tag="EnableRemoteInput"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 输入锁定放行: hook/tdmaster.cpp LockLocalInput -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72D;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="输入锁定放行" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-input-lock"/>
                                <TextBlock Text="TDMaster LockLocalInput 放行，本地输入不被锁定"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="即使被锁定输入也能继续使用" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchInputLock" Tag="EnableInputLock"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 进程操作守护: hook/procguard.cpp CreateProcess/TerminateProcess/关机 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="进程操作守护" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-proc-guard"/>
                                <TextBlock Text="拦截 CreateProcess / WinExec / TerminateProcess / 关机指令"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端无法结束你的程序或关机" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchProcGuard" Tag="EnableProcGuard"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 进程终止能力屏蔽: master_hook/guard.cpp TDProcHookEnableTerminate -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE74D;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="进程终止能力屏蔽" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-proc-hook-guard"/>
                                <TextBlock Text="拦截 TDProcHookEnableTerminate，教师端无法启用进程终止"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端的“结束进程”功能失效" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchProcHookGuard" Tag="EnableProcHookGuard"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 设备过滤屏蔽: hook/filterguard.cpp fltlib -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7C3;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="设备过滤屏蔽" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-filter-guard"/>
                                <TextBlock Text="拦截 fltlib 通信，USB / CD / 程序执行过滤失效"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端无法禁用你的 USB 和光驱" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchFilterGuard" Tag="EnableFilterGuard"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 网络仿真屏蔽: master_hook/guard.cpp BeginSimulate/StopSimulate -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE774;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="网络过滤/仿真屏蔽" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-net-sim"/>
                                <TextBlock Text="拦截断网模拟指令与网页过滤规则下发 (TDNetFilter)"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端的断网模拟指令无效" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchNetSim" Tag="EnableNetSimBlock"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 块2: 界面与进程 (窗口化) ============ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71D;" FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="界面与进程 (窗口化)" Style="{StaticResource SubtitleTextBlockStyle}" Tag="name-group-ui"/>
                        </StackPanel>

                        <!-- 置顶窗口剥离: hook/topmost.cpp CreateWindowExW WS_EX_TOPMOST -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE738;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="置顶窗口剥离" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-topmost-strip"/>
                                <TextBlock Text="创建窗口时剥离 WS_EX_TOPMOST，控制窗口不再置顶"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="控制/黑屏窗口不会盖住你的窗口" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchTopmostStrip" Tag="EnableTopmostStrip"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 焦点锁定拦截: hook/focuslock.cpp -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="焦点锁定拦截" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-focus-lock"/>
                                <TextBlock Text="黑屏/控制窗口无法抢焦点 (SetForegroundWindow 等)"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="控制窗口无法强制跳到最前面" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchFocusLock" Tag="EnableFocusLock"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 应用列表屏蔽: hook/applist.cpp EnumWindows -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="应用列表屏蔽" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-app-list"/>
                                <TextBlock Text="过滤 EnumWindows，教师端看不到你打开的窗口"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端看不到你打开的程序" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchAppList" Tag="EnableAppList"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 进程列表屏蔽: hook/proclist.cpp Process32FirstW/EnumProcesses -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7C4;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="进程列表屏蔽" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-proc-list"/>
                                <TextBlock Text="过滤 Process32FirstW / EnumProcesses，隐藏本机进程"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端看不到你运行的进程" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchProcList" Tag="EnableProcList"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 块3: 屏幕监控 ============ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7B8;" FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="屏幕监控" Style="{StaticResource SubtitleTextBlockStyle}" Tag="name-group-screen"/>
                        </StackPanel>

                        <!-- 屏幕假屏: hook/screen.cpp EncodeToJPEGBuffer -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE787;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="屏幕假屏" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-screen-fake"/>
                                <TextBlock Text="截屏编码时注入伪造画面 (screen.png)"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端看到的屏幕是假画面" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchScreenFake" Tag="EnableScreenFake"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 屏幕捕获屏蔽: hook/screencap.cpp BitBlt -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE790;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="屏幕捕获屏蔽" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-screen-cap"/>
                                <TextBlock Text="BitBlt 返回伪造画面，监控/录屏看到的是假屏"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端无法截取你的屏幕" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchScreenCap" Tag="EnableScreenCap"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>

                        <!-- 黑屏监控: monitor/monitor.cpp -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE768;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="黑屏监控" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-black-monitor"/>
                                <TextBlock Text="检测教师端黑屏指令并自动窗口化"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="被黑屏时自动恢复窗口" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchBlackMonitor" Tag="EnableBlackMonitor"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 块4: 输入 ============ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7B3;" FontSize="16"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="输入" Style="{StaticResource SubtitleTextBlockStyle}" Tag="name-group-input"/>
                        </StackPanel>

                        <!-- 键盘钩子绕过: hook/keyboard.cpp WH_KEYBOARD_LL/WH_MOUSE_LL -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE765;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="键盘钩子绕过" Style="{StaticResource BodyStrongTextBlockStyle}" Tag="name-keyboard-bypass"/>
                                <TextBlock Text="教师端低级键鼠钩子替换为空钩子，输入不被监控锁定"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="tech"/>
			<TextBlock Text="教师端无法记录你的键盘输入" Style="{StaticResource CaptionTextBlockStyle}"
			           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="novice"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="SwitchKeyboardBypass" Tag="EnableKeyboardBypass"
                                          Toggled="OnFeatureToggled" OffContent="关" OnContent="开"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
